# ---- Server ----
PORT=3000
NODE_ENV=development
# Set to 1 only when running behind a reverse proxy (so rate limiting sees real client IPs)
TRUST_PROXY=0

# Optional: if set, /api/python-analytics requires "Authorization: Bearer <token>"
# (or header x-dashboard-token). Generate one with:  openssl rand -hex 32
DASHBOARD_ACCESS_TOKEN=

# ---- Supabase (read by python_analytics.py) ----
SUPABASE_URL=https://https://ethereal-cafe.ai.studio
# SERVER-ONLY secret. Never prefix with VITE_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh2dGt4d3p4anVvZWV3YWxwdG1xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MDI2MTg1MywiZXhwIjoyMTA1ODM3ODUzfQ.aJrGbKer_c04gJa2VV0qIh3JeI-csxTPLI7xlvCT6nI
# Alternative if you prefer the anon key (needs matching RLS read policies):
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh2dGt4d3p4anVvZWV3YWxwdG1xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyNjE4NTMsImV4cCI6MjEwNTgzNzg1M30.DVn4CeI1MIO4lH6qfEMYKZd8JkpRb5bHT0pNOKnqp7A

# ---- Optional tuning ----
# Seconds the server reuses analytics results (0 disables caching)
ANALYTICS_CACHE_TTL_MS=60000
PY_TIMEOUT_MS=30000
PYTHON_BIN=python3
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Max rows downloaded per table
ANALYTICS_MAX_ROWS=100000
# Hours added to UTC before grouping by hour (8 = UTC+8)
CAFE_UTC_OFFSET_HOURS=0

# ---- Table name overrides (defaults shown) ----
# SUPABASE_TABLE_SESSIONS=sessions
# SUPABASE_TABLE_UNITS=units
# SUPABASE_TABLE_EARNINGS=earnings
# SUPABASE_TABLE_CUSTOMERS=customers
